POSTGRES_DB=quant_lab
POSTGRES_USER=quant_lab
POSTGRES_PASSWORD=quant_lab_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATASET_STORAGE_PATH=./data/snapshots
API_HOST=127.0.0.1
API_PORT=8000

# Alpaca PAPER/BASIC only. Never place real account credentials here.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_MARKET_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_MARKET_DATA_FEED=iex

# Real Alpaca checks are opt-in; order tests require the second explicit flag.
RUN_ALPACA_INTEGRATION_TESTS=false
RUN_ALPACA_PAPER_ORDER_TESTS=false
