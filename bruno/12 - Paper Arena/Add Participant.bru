meta {
  name: Add promoted StrategyVersion
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/v1/paper/sessions/{{sessionId}}/participants
  body: json
  auth: none
}
body:json {
  {"paper_promotion_id":"{{paperPromotionId}}","strategy_version_id":"{{versionId}}"}
}
script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("participantId", res.body.id);
    bru.setEnvVar("paperParticipantId", res.body.id);
  }
}
