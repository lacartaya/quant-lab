meta {
  name: Run parameter sensitivity
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/v1/experiment-runs/{{runId}}/validations/parameter-sensitivity
  body: json
  auth: none
}
body:json {
  {"parameters":{"short_window":[40,50,60],"long_window":[180,200,220]},"maximum_combinations":9}
}
script:post-response {
  if (res.status === 201) bru.setEnvVar("sensitivityValidationId", res.body.id);
}
